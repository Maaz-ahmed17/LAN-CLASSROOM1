{
  "name": "lan-classroom",
  "version": "1.1.0",
  "description": "LAN classroom control: monitor, freeze, message, share screen and files",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg . --targets node20-win-x64 --output dist/LAN-Classroom.exe"
  },
  "pkg": { "assets": ["public/**/*"] },
  "dependencies": {
    "express": "4.19.2",
    "qrcode": "1.5.4",
    "selfsigned": "2.4.1",
    "ws": "8.17.1"
  },
  "devDependencies": { "@yao-pkg/pkg": "5.12.0" }
}
